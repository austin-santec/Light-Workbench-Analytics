# Optional local settings. Copy to backend/.env; run commands from backend/.
LWA_APP_NAME="Light Workbench Analytics API"
LWA_ENVIRONMENT=development
LWA_LOG_LEVEL=info
LWA_HOST=127.0.0.1
LWA_PORT=8000
# Empty by default: the frontend does not call this API in Milestone 2.
# If explicitly needed later: ["http://127.0.0.1:5173"]
LWA_CORS_ORIGINS=[]
